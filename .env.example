# Neon DB Connection String
# Get this from your Neon dashboard: https://console.neon.tech
DATABASE_URL="postgresql://user:password@ep-cool-db-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ============================================
# Gemini / Google Generative AI
# ============================================
# The canonical env var the @ai-sdk/google provider reads. WITHOUT this set,
# POST /api/chat returns 500 with: "Google Generative AI API key is missing".
# Get a key at: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=""

# Optional rotation pool. If the primary key hits a 429 / quota error, the
# chat route will fall back to GEMINI_API_KEY_1, then _2, then _3 in order.
GEMINI_API_KEY_1=""
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""

# ============================================
# Resend (transactional email) — https://resend.com/api-keys
# ============================================
RESEND_API_KEY=""

# ============================================
# Admin Panel Password (used with username: kidus)
# ============================================
ADMIN_PASSWORD="change-me-to-something-strong"

# ============================================
# Gmail SMTP (used for the mass-emailer feature)
# ============================================
GMAIL_USER=""
GMAIL_APP_PASSWORD=""